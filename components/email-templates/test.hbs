<table
  role='presentation'
  width='100%'
  cellpadding='0'
  cellspacing='0'
  style='background-color: #f4f4f4; padding: 32px 0; font-family: Arial, Helvetica, sans-serif;'
>
  <tr>
    <td align='center'>
      <table
        role='presentation'
        width='600'
        cellpadding='0'
        cellspacing='0'
        style='max-width: 600px; width: 100%; background-color: #ffffff; border: 1px solid #e2e8f0; border-radius: 6px; overflow: hidden;'
      >
        {{> header}}

        <tr>
          <td style='padding: 32px; background-color: #292b2d;'>
            <h2 style='margin: 0 0 16px; font-size: 22px; line-height: 30px; color: #ffffff; font-weight: 700;'>
              Welcome, {{name}}!
            </h2>

            <p style='margin: 0; font-size: 15px; line-height: 24px; color: #e2e8f0;'>
              You are signed in as <strong style='color: #ed1c24;'>{{role}}</strong>.
            </p>
          </td>
        </tr>

        {{> footer}}
      </table>
    </td>
  </tr>
</table>
