datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

generator client {
    provider = "prisma-client-js"
}

model User {
    id                       String    @id @default(cuid())
    code                     Int       @unique @default(autoincrement())
    username                 String    @unique
    fname                    String
    lname                    String
    email                    String    @unique
    emailVerified            DateTime?
    password                 String    @default("")
    roleCode                 Int
    isOnline                 Boolean   @default(false)
    isActive                 Boolean   @default(true)
    location                 String?
    lastIpAddress            String?
    lastSignin               DateTime?
    isDefaultPasswordChanged Boolean   @default(false)
    isLocked                 Boolean   @default(false)
    failedLoginAttempts      Int       @default(0) //* failed login attempts will be reset to 0 when user is unlocked and succesfully signin
    customerCode             String?
    supplierCode             String?

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?
    createdBy String?
    updatedBy String?
    deletedBy String?

    accounts Account[]
    profile  Profile?
    role     Role      @relation(fields: [roleCode], references: [code])

    projectGroupPics              ProjectGroupPic[]           @relation(name: "User-ProjectGroupPic")
    projectIndividualSalesClosers ProjectIndividual[]         @relation(name: "User-ProjectIndividual-SalesCloser")
    projectIndividualPics         ProjectIndividualPic[]      @relation(name: "User-ProjectIndividualPic")
    projectIndividualCustomers    ProjectIndividualCustomer[] @relation(name: "User-ProjectIndividualCustomer")
    workOrders                    WorkOrder[]
    projectItemDateReceivedBy     ProjectItem[]               @relation()
}

model Role {
    id          String  @id @default(cuid())
    code        Int     @unique @default(autoincrement())
    name        String
    key         String  @unique
    description String? @default("")

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?
    createdBy String?
    updatedBy String?
    deletedBy String?

    users           User[]
    rolePermissions RolePermission[]
    roleReports      RoleReport[]
    roleSapDatabases RoleSapDatabase[]
}

model Permission {
    id             String   @id @default(uuid())
    code           String   @unique
    name           String
    description    String?  @default("")
    isParent       Boolean  @default(false)
    parentId       String?
    allowedActions String[] //* default actions 'view', 'create', 'edit', 'delete

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?
    createdBy String?
    updatedBy String?
    deletedBy String?

    parent          Permission?      @relation(name: "Permission-Permission", fields: [parentId], references: [id])
    children        Permission[]     @relation("Permission-Permission")
    rolePermissions RolePermission[]
}

model RolePermission {
    roleId       String
    permissionId String
    actions      String[] @default([])

    role       Role       @relation(fields: [roleId], references: [id], onUpdate: Cascade, onDelete: Cascade)
    permission Permission @relation(fields: [permissionId], references: [id], onUpdate: Cascade, onDelete: Cascade)

    @@unique([roleId, permissionId])
    @@index([actions], type: Gin)
}

model Profile {
    id       String @id @default(cuid())
    code     Int    @unique @default(autoincrement())
    userCode Int    @unique

    details Json?

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?
    createdBy String?
    updatedBy String?
    deletedBy String?

    user User @relation(fields: [userCode], references: [code], onUpdate: Cascade, onDelete: Cascade)
}

model Account {
    userId            String
    type              String
    provider          String
    providerAccountId String
    refresh_token     String?
    access_token      String?
    expires_at        Int?
    token_type        String?
    scope             String?
    id_token          String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    user User @relation(fields: [userId], references: [id], onUpdate: Cascade, onDelete: Cascade)

    @@id([provider, providerAccountId])
}

//* event notify
model Notification {
    id         String  @id @default(cuid())
    code       Int     @unique @default(autoincrement())
    dbCode     String? //* null for global user or role events, set for a tenant event
    title      String
    message    String  @db.Text
    link       String?
    entityType String? //* user, project, item, etc
    entityCode Int?
    entityId   String?
    metaData   Json? //* contains additional data

    //* audience fields
    userCodes  Int[]    @default([])
    roleCodes  Int[]    @default([])
    roleKeys   String[] @default([])
    isGlobal   Boolean  @default(false)
    isInternal Boolean  @default(false)

    //* blocking fields
    excludeUserCodes Int[]    @default([])
    excludeRoleCodes Int[]    @default([])
    excludeRoleKeys  String[] @default([])

    createdAt DateTime  @default(now())
    expiresAt DateTime? //* should expire 1month  //* can be use to handle auto deletion of notification via cron job 
    createdBy String?

    receipts NotificationReceipt[]

    @@index([dbCode])
    //* Gin - Generalized Inverted Index (designed for fast and efficient querying of values such as Arrays, JSONB)
    @@index([userCodes], type: Gin)
    @@index([roleCodes], type: Gin)
    @@index([roleKeys], type: Gin)
}

//* event user interaction
model NotificationReceipt {
    id               String @id @default(cuid())
    code             Int    @unique @default(autoincrement())
    notificationCode Int

    userCode  Int
    readAt    DateTime?
    deletedAt DateTime?

    notification Notification @relation(fields: [notificationCode], references: [code], onUpdate: Cascade, onDelete: Cascade)

    @@unique([notificationCode, userCode])
    @@index([userCode, readAt, deletedAt])
}

model BusinessPartner {
    id       String  @id @default(cuid())
    code     Int     @unique @default(autoincrement())
    dbCode   String
    isActive Boolean @default(true)

    //* sap fields
    CardCode   String
    CardName   String
    CardType   String
    CntctPrsn  String?
    CurrName   String?
    CurrCode   String?
    GroupCode  Int?
    GroupName  String?
    GroupNum   Int?
    PymntGroup String?
    Phone1     String?
    ShipToDef  String?
    BillToDef  String?
    AcctType   String?
    CmpPrivate String?

    syncStatus String @default("pending") //* pending, synced 

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?
    createdBy String?
    updatedBy String?
    deletedBy String?

    addresses                  Address[]
    contacts                   Contact[]
    projectIndividualSuppliers ProjectIndividualSupplier[] @relation(name: "BusinessPartner-ProjectIndividualSupplier")

    @@unique([dbCode, CardCode])
}

model Address {
    id                   String  @id @default(cuid())
    dbCode               String
    //* sap fields
    CardCode             String
    AddressName          String
    AddrType             String
    Street               String?
    Address2             String?
    Address3             String?
    StreetNo             String?
    BuildingFloorRoom    String?
    Block                String?
    City                 String?
    ZipCode              String?
    County               String?
    CountryCode          String?
    CountryName          String?
    StateCode            String?
    StateName            String?
    GlobalLocationNumber String?

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?
    createdBy String?
    updatedBy String?
    deletedBy String?

    businessPartner BusinessPartner @relation(fields: [dbCode, CardCode], references: [dbCode, CardCode], onUpdate: Cascade, onDelete: Cascade)

    @@unique([dbCode, CardCode, AddressName, AddrType])
    @@index([CardCode])
}

model Contact {
    id          String  @id @default(cuid())
    dbCode      String
    //* sap fields
    CardCode    String
    ContactName String
    FirstName   String?
    LastName    String?
    Title       String?
    Position    String?
    Phone1      String?
    Phone2      String?
    MobilePhone String?
    Email       String?

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?
    createdBy String?
    updatedBy String?
    deletedBy String?

    businessPartner BusinessPartner @relation(fields: [dbCode, CardCode], references: [dbCode, CardCode], onUpdate: Cascade, onDelete: Cascade)

    @@unique([dbCode, CardCode, ContactName])
    @@index([CardCode])
}

model Item {
    //TODO: remove manufacturerPartNumber, manufacturer, description - instead use sap fields
    id        String  @id @default(cuid())
    code      Int     @unique @default(autoincrement())
    dbCode    String
    thumbnail String?
    notes     String?
    isActive  Boolean @default(true)

    //* sap fields
    ItemCode   String
    ItemName   String?
    FirmCode   Int?
    FirmName   String?
    ItmsGrpCod Int?
    ItmsGrpNam String?
    Price      Decimal? @db.Decimal(18, 6)

    syncStatus String @default("pending") //* pending, synced 

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?
    createdBy String?
    updatedBy String?
    deletedBy String?

    projectItems ProjectItem[]

    @@unique([dbCode, ItemCode])
    @@index([deletedAt])
    @@index([ItemCode(ops: raw("gin_trgm_ops"))], type: Gin)
    @@index([ItemName(ops: raw("gin_trgm_ops"))], type: Gin)
    @@index([FirmName(ops: raw("gin_trgm_ops"))], type: Gin)
}

model Warehouse {
    id       String  @id @default(cuid())
    code     Int     @unique @default(autoincrement())
    dbCode   String
    isActive Boolean @default(true)

    //* SAP fields
    WarehouseCode        String
    WarehouseName        String
    Nettable             Boolean
    EnableBinLocations   Boolean
    DefaultBin           Int?
    Street               String?
    Address2             String?
    Address3             String?
    StreetNo             String?
    BuildingFloorRoom    String?
    Block                String?
    City                 String?
    ZipCode              String?
    County               String?
    CountryCode          String?
    CountryName          String?
    StateCode            String?
    StateName            String?
    GlobalLocationNumber String?

    syncStatus String @default("pending") //* pending, synced 

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?
    createdBy String?
    updatedBy String?
    deletedBy String?

    binLocations      WarehouseBinLocation[]
    projectItems      ProjectItem[]
    projectWarehouses ProjectIndividualWarehouse[]

    @@unique([dbCode, WarehouseCode])
}

model WarehouseBinLocation {
    id     String @id @default(cuid())
    code   Int    @unique @default(autoincrement())
    dbCode String

    //* SAP fields
    WarehouseCode String
    Description   String?
    BinCode       String
    SL1Code       String
    SL2Code       String?
    SL3Code       String?
    SL4Code       String?

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?
    createdBy String?
    updatedBy String?
    deletedBy String?

    warehouse    Warehouse     @relation(fields: [dbCode, WarehouseCode], references: [dbCode, WarehouseCode], onUpdate: Cascade, onDelete: Cascade)
    projectItems ProjectItem[] @relation()

    @@unique([dbCode, BinCode])
}

model ProjectGroup {
    id          String  @id @default(cuid())
    code        Int     @unique @default(autoincrement())
    dbCode      String
    name        String
    description String?
    isActive    Boolean @default(true)

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?
    createdBy String?
    updatedBy String?
    deletedBy String?

    projectIndividuals ProjectIndividual[] @relation()
    projectGroupPics   ProjectGroupPic[]   @relation(name: "ProjectGroup-ProjectGroupPic")

    @@unique([dbCode, name])
    @@index([deletedAt])
    @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
}

model ProjectGroupPic {
    id               String @id @default(cuid())
    dbCode           String
    projectGroupCode Int
    userCode         Int

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?
    createdBy String?
    updatedBy String?
    deletedBy String?

    projectGroup ProjectGroup @relation(name: "ProjectGroup-ProjectGroupPic", fields: [projectGroupCode], references: [code], onUpdate: Cascade, onDelete: Cascade)
    user         User         @relation(name: "User-ProjectGroupPic", fields: [userCode], references: [code], onUpdate: Cascade, onDelete: Cascade)

    @@unique([projectGroupCode, userCode])
    @@index([dbCode])
    @@index([projectGroupCode])
    @@index([userCode])
}

model ProjectIndividual {
    id                      String   @id @default(cuid())
    code                    Int      @unique @default(autoincrement())
    dbCode                  String
    name                    String
    groupCode               Int?
    description             String?
    isActive                Boolean  @default(true)
    salesCloser             Int?
    projectItemHiddenFields String[] @default([])

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?
    createdBy String?
    updatedBy String?
    deletedBy String?

    projectGroup ProjectGroup? @relation(fields: [groupCode], references: [code], onUpdate: Cascade, onDelete: Cascade)

    projectIndividualPics       ProjectIndividualPic[]       @relation(name: "ProjectIndividual-ProjectIndividualPic")
    projectIndividualCustomers  ProjectIndividualCustomer[]  @relation(name: "ProjectIndividual-ProjectIndividualCustomer")
    projectIndividualSuppliers  ProjectIndividualSupplier[]  @relation(name: "ProjectIndividual-ProjectIndividualSupplier")
    items                       ProjectItem[]
    workOrders                  WorkOrder[]
    userSalesCloser             User?                        @relation(name: "User-ProjectIndividual-SalesCloser", fields: [salesCloser], references: [code], onUpdate: Cascade, onDelete: Cascade)
    projectIndividualWarehouses ProjectIndividualWarehouse[] @relation(name: "ProjectIndividual-ProjectIndividualWarehouse")

    @@unique([dbCode, name])
    @@index([deletedAt])
    @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
}

//* NOTE: Item must be synced already in SAP before it can be selected for project item 
model ProjectItem {
    id                    String @id @default(cuid())
    code                  Int    @unique @default(autoincrement())
    dbCode                String
    itemCode              Int
    projectIndividualCode Int

    warehouseCode   String?
    binCode         String?
    partNumber      String?
    dateCode        String?
    countryOfOrigin String?
    lotCode         String?
    palletNo        String?
    packagingType   String?
    spq             String?
    dateReceived    DateTime?
    dateReceivedBy  Int?
    cost            Decimal?  @default(0) @db.Decimal(18, 6)
    stockIn         Decimal?  @default(0) @db.Decimal(18, 2)
    stockOut        Decimal?  @default(0) @db.Decimal(18, 2)
    totalStock      Decimal?  @default(0) @db.Decimal(18, 2)
    siteLocation    String?   @default("")
    subLocation2    String?
    subLocation3    String?
    notes           String?
    owner           String?
    commodities     String?
    group           String?
    division        String?
    site            String?
    cmSite          String?
    phase           Int?
    tfsStdPrice     Decimal?  @default(0) @db.Decimal(18, 6)
    omegaPrice      Decimal?  @default(0) @db.Decimal(18, 6)

    syncStatus String @default("pending") //* pending, synced 

    mfr  String? //* temporary field manufacturer field
    desc String? //* temporary field description field

    //* sap field
    DistNumber String?

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?
    createdBy String?
    updatedBy String?
    deletedBy String?

    item                 Item                  @relation(fields: [itemCode], references: [code], onUpdate: Cascade, onDelete: Cascade)
    projectIndividual    ProjectIndividual     @relation(fields: [projectIndividualCode], references: [code], onUpdate: Cascade, onDelete: Cascade)
    warehouse            Warehouse?            @relation(fields: [dbCode, warehouseCode], references: [dbCode, WarehouseCode], onUpdate: Cascade, onDelete: Cascade)
    warehouseBinLocation WarehouseBinLocation? @relation(fields: [dbCode, binCode], references: [dbCode, BinCode], onUpdate: Cascade, onDelete: Cascade)
    dateReceivedByUser   User?                 @relation(fields: [dateReceivedBy], references: [code], onUpdate: Cascade, onDelete: Cascade)

    workOrderItems WorkOrderItem[]

    @@unique([dbCode, DistNumber, warehouseCode, binCode, projectIndividualCode])
    @@index([projectIndividualCode])
    @@index([itemCode])
    @@index([dbCode])
    @@index([deletedAt])
    @@index([desc(ops: raw("gin_trgm_ops"))], type: Gin)
    @@index([mfr(ops: raw("gin_trgm_ops"))], type: Gin)
    @@index([partNumber(ops: raw("gin_trgm_ops"))], type: Gin)
}

model ProjectIndividualCustomer {
    id                    String @id @default(cuid())
    dbCode                String
    projectIndividualCode Int
    userCode              Int

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?
    createdBy String?
    updatedBy String?
    deletedBy String?

    projectIndividual ProjectIndividual @relation(name: "ProjectIndividual-ProjectIndividualCustomer", fields: [projectIndividualCode], references: [code], onUpdate: Cascade, onDelete: Cascade)
    user              User              @relation(name: "User-ProjectIndividualCustomer", fields: [userCode], references: [code], onUpdate: Cascade, onDelete: Cascade)

    @@unique([projectIndividualCode, userCode])
    @@index([projectIndividualCode])
    @@index([userCode])
}

model ProjectIndividualSupplier {
    id                    String @id @default(cuid())
    dbCode                String
    projectIndividualCode Int
    supplierCode          String

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?
    createdBy String?
    updatedBy String?
    deletedBy String?

    projectIndividual ProjectIndividual @relation(name: "ProjectIndividual-ProjectIndividualSupplier", fields: [projectIndividualCode], references: [code], onUpdate: Cascade, onDelete: Cascade)
    businessPartner   BusinessPartner   @relation(name: "BusinessPartner-ProjectIndividualSupplier", fields: [dbCode, supplierCode], references: [dbCode, CardCode], onUpdate: Cascade, onDelete: Cascade)

    @@unique([projectIndividualCode, supplierCode])
    @@index([dbCode])
    @@index([projectIndividualCode])
    @@index([supplierCode])
}

model ProjectIndividualPic {
    id                    String @id @default(cuid())
    dbCode                String
    projectIndividualCode Int
    userCode              Int

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?
    createdBy String?
    updatedBy String?
    deletedBy String?

    projectIndividual ProjectIndividual @relation(name: "ProjectIndividual-ProjectIndividualPic", fields: [projectIndividualCode], references: [code], onUpdate: Cascade, onDelete: Cascade)
    user              User              @relation(name: "User-ProjectIndividualPic", fields: [userCode], references: [code], onUpdate: Cascade, onDelete: Cascade)

    @@unique([projectIndividualCode, userCode])
    @@index([projectIndividualCode])
    @@index([userCode])
}

model ProjectIndividualWarehouse {
    id                    String @id @default(cuid())
    dbCode                String
    projectIndividualCode Int
    warehouseCode         String

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?
    createdBy String?
    updatedBy String?
    deletedBy String?

    projectIndividual ProjectIndividual @relation("ProjectIndividual-ProjectIndividualWarehouse", fields: [projectIndividualCode], references: [code], onUpdate: Cascade, onDelete: Cascade)
    warehouse         Warehouse         @relation(fields: [dbCode, warehouseCode], references: [dbCode, WarehouseCode], onUpdate: Cascade, onDelete: Cascade)

    @@unique([projectIndividualCode, warehouseCode])
    @@index([dbCode])
    @@index([projectIndividualCode])
    @@index([warehouseCode])
}

//* WORK ORDER STATUS
//? 1 - Open 
//? 2 - Pending 
//? 3 - In Process 
//? 4 - Verified 
//? 5 - Partial Delivery 
//? 6 - Delivered 
//? 7 - Cancelled
//? 8 - Deleted

model WorkOrder {
    id                      String    @id @default(cuid())
    code                    Int       @unique @default(autoincrement())
    dbCode                  String
    projectIndividualCode   Int
    userCode                Int
    status                  String
    isInternal              Boolean   @default(false)
    billingAddrCode         String?
    shippingAddrCode        String?
    comments                String?
    customerPo              String?
    isAlternativeAddr       Boolean   @default(false)
    alternativeBillingAddr  String?
    alternativeShippingAddr String?
    expectedDeliveryDate    DateTime? @db.Date
    duplicatedFromCode      Int?

    //* SAP fields
    salesOrderCode       Int?
    purchaseOrderCode    Int?
    goodsReceiptDocNum   Int?
    goodsReceiptDocEntry Int?
    goodsIssueDocNum     Int?
    goodsIssueDocEntry   Int?

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?
    createdBy String?
    updatedBy String?
    deletedBy String?

    projectIndividual ProjectIndividual @relation(fields: [projectIndividualCode], references: [code], onUpdate: Cascade, onDelete: Cascade)
    user              User              @relation(fields: [userCode], references: [code], onUpdate: Cascade, onDelete: Cascade)
    duplicatedFrom    WorkOrder?        @relation("WorkOrder-DuplicatedFrom", fields: [duplicatedFromCode], references: [code], onUpdate: Cascade, onDelete: SetNull)

    workOrderItems         WorkOrderItem[]
    workOrderStatusUpdates WorkOrderStatusUpdate[]
    duplicateWorkOrders    WorkOrder[]             @relation("WorkOrder-DuplicatedFrom")

    @@index([dbCode])
    @@index([projectIndividualCode])
    @@index([userCode])
}

model WorkOrderStatusUpdate {
    id            String  @id @default(cuid())
    code          Int     @unique @default(autoincrement())
    dbCode        String
    workOrderCode Int
    prevStatus    String
    currentStatus String
    comments      String?
    trackingNum   String?

    createdAt DateTime @default(now())
    updatedAt DateTime @default(now()) @updatedAt
    createdBy String?
    updatedBy String?

    workOrder WorkOrder @relation(fields: [workOrderCode], references: [code], onUpdate: Cascade, onDelete: Cascade)

    @@index([dbCode])
    @@index([workOrderCode])
}

//* isStockedIn -  //* when auto credit stock-in and lock qty upon WO creation was patched, set @default(true) for initial db push, set @default(false) - after inial db push to db
model WorkOrderItem {
    dbCode          String
    workOrderCode   Int
    projectItemCode Int
    qty             Decimal? @default(0) @db.Decimal(18, 2)
    isDelivered     Boolean  @default(false)
    // isStockedIn     Boolean  @default(false)

    workOrder   WorkOrder   @relation(fields: [workOrderCode], references: [code], onUpdate: Cascade, onDelete: Cascade)
    projectItem ProjectItem @relation(fields: [projectItemCode], references: [code], onUpdate: Cascade, onDelete: Cascade)

    @@unique([workOrderCode, projectItemCode])
    @@index([dbCode])
    @@index([workOrderCode])
    @@index([projectItemCode])
}

model FileAttachment {
    id          String @id @default(cuid())
    code        Int    @unique @default(autoincrement())
    dbCode      String
    refCode     Int? //* unique code of a entity
    modulelName String
    name        String
    type        String
    size        Int
    path        String

    uploadedAt DateTime @default(now())
    updatedAt  DateTime @default(now()) @updatedAt
    uploadedBy String?
    updatedBy  String?

    @@unique([dbCode, modulelName, name])
    @@index([modulelName])
}

//* REPORT TYPE
//? 1 - Dashboard 
//? 2 - Paginated 
//* only 1 default report, which visisble to any users
model Report {
    id          String  @id @default(cuid())
    code        Int     @unique @default(autoincrement())
    title       String
    fileName    String  @unique
    description String?
    isActive    Boolean @default(true)
    type        String
    data        String  @default("")
    isFeatured  Boolean @default(true)
    isDefault   Boolean @default(false)
    isInternal  Boolean @default(false)

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?
    createdBy String?
    updatedBy String?
    deletedBy String?

    roleReports RoleReport[]
}

model RoleReport {
    id         String @id @default(cuid())
    roleCode   Int
    reportCode Int

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?
    createdBy String?
    updatedBy String?
    deletedBy String?

    role   Role   @relation(fields: [roleCode], references: [code], onUpdate: Cascade, onDelete: Cascade)
    report Report @relation(fields: [reportCode], references: [code], onUpdate: Cascade, onDelete: Cascade)

    @@unique([roleCode, reportCode])
    @@index([roleCode])
    @@index([reportCode])
}

model RoleSapDatabase {
    id              String @id @default(cuid())
    roleCode        Int
    sapDatabaseCode String

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?
    createdBy String?
    updatedBy String?
    deletedBy String?

    role        Role        @relation(fields: [roleCode], references: [code], onUpdate: Cascade, onDelete: Cascade)
    sapDatabase SapDatabase @relation(fields: [sapDatabaseCode], references: [dbCode], onUpdate: Cascade, onDelete: Cascade)

    @@unique([roleCode, sapDatabaseCode])
    @@index([roleCode])
    @@index([sapDatabaseCode])
}

model Settings {
    id       String  @id @default(cuid())
    roleCode Int?
    code     Int     @unique @default(autoincrement())
    data     Json //* JSON containing all settings
    isGlobal Boolean @default(false)

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?
    createdBy String?
    updatedBy String?
    deletedBy String?
}

//* multi-tenant sap database switcher
//* for the time being single user will access the DB and just stored the session seprately
//* And just query / use session based on the selected SAP DB (db code)
model SapDatabase {
    id       String  @id @default(cuid())
    name     String
    dbCode   String  @unique
    order    Int     @default(0)
    isActive Boolean @default(true) //* inactive DBs will not be shown

    createdAt       DateTime         @default(now())
    updatedAt       DateTime         @default(now()) @updatedAt
    sapSession       SapSession?
    roleSapDatabases RoleSapDatabase[]
}

model SapSession {
    id        String   @id @default(cuid())
    dbCode    String   @unique //* one active session per DB
    b1Session String
    routeId   String?
    expiresAt DateTime

    sapDatabase SapDatabase @relation(fields: [dbCode], references: [dbCode], onUpdate: Cascade, onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @default(now()) @updatedAt
}

//* synchronization metadata table
model SyncMeta {
    id          String   @id @default(uuid())
    code        String
    dbCode      String
    description String?
    lastSyncAt  DateTime @default(now())

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?
    createdBy String?
    updatedBy String?
    deletedBy String?

    @@unique([dbCode, code])
}

//* add model system logs

//* dimension tables
//* date dimension table
model DimDate {
    id   Int      @id @default(autoincrement())
    date DateTime @unique @db.Date //* actual calendar date

    day       Int //* 1-31
    dayOfWeek Int //* 0-6 (Sunday-Saturday)
    dayName   String //* Sunday-Saturday

    weekOfYear Int //* week number within the year
    isoWeek    Int //* ISO-8601 standard week number

    month     Int //* 1-12
    monthName String //* January-December

    quarter  Int //* 1-4
    halfYear Int //* 1-2
    year     Int //* Calendar year

    isWeekend    Boolean //* indicates if the day is saturday or sunday
    isMonthStart Boolean //* indicates if the day is the first day of the month
    isMonthEnd   Boolean //* indicates if the day is the last day of the month
    isYearStart  Boolean //* indicates if the day is the first day of the year
    isYearEnd    Boolean //* indicates if the day is the last day of the year

    createdAt DateTime @default(now())

    @@index([year])
    @@index([year, month])
    @@index([year, weekOfYear])
}
